+def _tpu_splash_min_kv() -> int:
+    import os
+
+    return int(os.environ.get("TABICL_TPU_SPLASH_MIN_KV", "16384"))
+
+
+@torch.compiler.assume_constant_result
+def _get_tpu_rect_splash_kernel(
+    H: int,
+    T_q_pad: int,
+    T_kv_pad: int,
+    D: int,
+    bq: int,
+    bkv: int,
+    has_segment_ids: bool,
+):
+    """Build and cache a TorchTPU Pallas Splash Attention custom op for rectangular (T_q_pad, T_kv_pad)."""
+    key = (H, T_q_pad, T_kv_pad, D, bq, bkv, has_segment_ids)
+    cached = _TPU_SPLASH_KERNEL_CACHE.get(key)
+    if cached is not None:
+        return cached
+
+    import jax
+    import jax.numpy as jnp
+    from jax.experimental.pallas.ops.tpu.splash_attention import (
+        splash_attention_kernel,
+        splash_attention_mask,
+    )
+    import torch_tpu._internal.pallas as tpu_pallas
+
+    mask = splash_attention_mask.MultiHeadMask(
+        [splash_attention_mask.FullMask((T_q_pad, T_kv_pad)) for _ in range(H)]
+    )
+    block_sizes = splash_attention_kernel.BlockSizes(
+        block_q=bq,
+        block_kv=bkv,
+        block_kv_compute=min(bkv, 512),
+    )
+    splash_single = splash_attention_kernel.make_splash_mha(
+        mask=mask,
+        head_shards=1,
+        q_seq_shards=1,
+        block_sizes=block_sizes,
+    )
+
+    if has_segment_ids:
+        vmapped = jax.vmap(splash_single, in_axes=(0, 0, 0, None))
+
+        def _jax_splash_seg(q, k, v, valid_kv):
+            q_seg = jnp.ones((T_q_pad,), dtype=jnp.int32)
+            kv_idx = jnp.arange(T_kv_pad, dtype=jnp.int32)
+            kv_seg = jnp.where(kv_idx < valid_kv, 1, 0).astype(jnp.int32)
+            seg = splash_attention_kernel.SegmentIds(q=q_seg, kv=kv_seg)
+            return vmapped(q, k, v, seg)
+
+        kernel = tpu_pallas.custom_jax_kernel(
+            _jax_splash_seg,
+            f"tabicl::splash_seg_{H}_{T_q_pad}_{T_kv_pad}_{D}_{bq}_{bkv}",
+            warn_deprecated=False,
+        )
+    else:
+        vmapped = jax.vmap(splash_single, in_axes=(0, 0, 0))
+
+        def _jax_splash_full(q, k, v):
+            return vmapped(q, k, v)
+
+        kernel = tpu_pallas.custom_jax_kernel(
+            _jax_splash_full,
+            f"tabicl::splash_full_{H}_{T_q_pad}_{T_kv_pad}_{D}_{bq}_{bkv}",
+            warn_deprecated=False,
+        )
+
+    _TPU_SPLASH_KERNEL_CACHE[key] = kernel
+    return kernel
+
+
+@torch.library.custom_op("tabicl::tpu_splash_sdpa_seg", mutates_args=())
+def _tpu_splash_sdpa_seg_op(
+    q_in: Tensor, k_in: Tensor, v_in: Tensor, valid_kv_t: Tensor, bq: int, bkv: int
+) -> Tensor:
+    _, H, T_q_pad, D = q_in.shape
+    T_kv_pad = k_in.shape[-2]
+    kernel = _get_tpu_rect_splash_kernel(H, T_q_pad, T_kv_pad, D, bq, bkv, True)
+    return kernel(q_in, k_in, v_in, valid_kv_t)
+
+
+@_tpu_splash_sdpa_seg_op.register_fake
+def _(q_in: Tensor, k_in: Tensor, v_in: Tensor, valid_kv_t: Tensor, bq: int, bkv: int) -> Tensor:
+    return torch.empty_like(q_in)
+
+
+@torch.library.custom_op("tabicl::tpu_splash_sdpa_full", mutates_args=())
+def _tpu_splash_sdpa_full_op(q_in: Tensor, k_in: Tensor, v_in: Tensor, bq: int, bkv: int) -> Tensor:
+    _, H, T_q_pad, D = q_in.shape
+    T_kv_pad = k_in.shape[-2]
+    kernel = _get_tpu_rect_splash_kernel(H, T_q_pad, T_kv_pad, D, bq, bkv, False)
+    return kernel(q_in, k_in, v_in)
+
+
+@_tpu_splash_sdpa_full_op.register_fake
+def _(q_in: Tensor, k_in: Tensor, v_in: Tensor, bq: int, bkv: int) -> Tensor:
+    return torch.empty_like(q_in)
+
+
+def _tpu_pallas_splash_sdpa(
+    q: Tensor,
+    k: Tensor,
+    v: Tensor,
+    valid_kv_len: Optional[Union[int, Tensor]] = None,
+) -> Tensor:
+    """Execute rectangular TorchTPU Pallas Splash Attention without scoped-VMEM OOM at >=16K keys."""
+    _, H, T_q, D = q.shape
+    T_kv = k.shape[-2]
+    bkv = 1024
+    bq = 128 if T_q <= 256 else (512 if T_q < 1024 else 1024)
+    T_q_pad = ((T_q + bq - 1) // bq) * bq
+    T_kv_pad = ((T_kv + bkv - 1) // bkv) * bkv
+
+    q_scaled = (q * (D**-0.5)).contiguous()
+    q_in = F.pad(q_scaled, (0, 0, 0, T_q_pad - T_q)).contiguous() if T_q_pad != T_q else q_scaled
+    k_in = F.pad(k, (0, 0, 0, T_kv_pad - T_kv)).contiguous() if T_kv_pad != T_kv else k.contiguous()
+    v_in = F.pad(v, (0, 0, 0, T_kv_pad - T_kv)).contiguous() if T_kv_pad != T_kv else v.contiguous()
+
+    if isinstance(valid_kv_len, Tensor):
+        valid_kv_t = valid_kv_len.to(device=q.device, dtype=torch.int32).reshape(())
+        out = _tpu_splash_sdpa_seg_op(q_in, k_in, v_in, valid_kv_t, bq, bkv)
+    else:
+        eff_kv = T_kv if valid_kv_len is None else int(valid_kv_len)
+        if eff_kv == T_kv_pad:
+            out = _tpu_splash_sdpa_full_op(q_in, k_in, v_in, bq, bkv)
+        else:
+            valid_kv_t = torch.full((), eff_kv, dtype=torch.int32, device=q.device)
+            out = _tpu_splash_sdpa_seg_op(q_in, k_in, v_in, valid_kv_t, bq, bkv)
+
+    if T_q_pad != T_q:
+        out = out[:, :, :T_q, :]
+    return out
+
+
+def _tiled_online_sdpa(
+    q: Tensor,
+    k: Tensor,
+    v: Tensor,
+    attn_mask: Optional[Tensor] = None,
+    kv_chunk: int = 4096,
+) -> Tensor:
+    """Autograd-safe online-softmax KV-tiled SDPA fallback for long sequences when Splash is not applicable."""
+    orig_dtype = q.dtype
+    D = q.shape[-1]
+    T_kv = k.shape[-2]
+    scale = D**-0.5
+    q_f = q * scale
+
+    m = torch.full((*q.shape[:-1], 1), float("-inf"), dtype=torch.float32, device=q.device)
+    l = torch.zeros((*q.shape[:-1], 1), dtype=torch.float32, device=q.device)
+    acc = torch.zeros_like(q, dtype=torch.float32)
+
+    for s in range(0, T_kv, kv_chunk):
+        e = min(s + kv_chunk, T_kv)
+        scores = torch.matmul(q_f, k[:, :, s:e, :].transpose(-2, -1)).float()
+        if attn_mask is not None:
+            m_slice = attn_mask[..., s:e]
+            if m_slice.dtype == torch.bool:
+                scores = scores.masked_fill(~m_slice, float("-inf"))
+            else:
+                scores = scores + m_slice.float()
+        chunk_max = scores.amax(dim=-1, keepdim=True)
+        new_m = torch.maximum(m, chunk_max)
+        alpha = torch.exp(m - new_m)
+        p = torch.exp(scores - new_m)
+        l = l * alpha + p.sum(dim=-1, keepdim=True)
+        acc = acc * alpha + torch.matmul(p.to(v.dtype), v[:, :, s:e, :]).float()
+        m = new_m
+
+    return (acc / l.clamp_min(1e-20)).to(orig_dtype)
+
